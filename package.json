{
  "name": "warp-toad",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "f:prep": "pnpm --filter frontend generate:abis && pnpm --filter frontend pull:addresses",
    "f:dev": "pnpm --filter frontend dev",
    "f:run": "pnpm --filter frontend build && pnpm --filter frontend preview",
    "b:compile": "pnpm --filter @warp-toad/backend compile",
    "b:test": "pnpm --filter @warp-toad/backend test",
    "b:build": "pnpm --filter @warp-toad/backend build",
    "b:warptoad:compile": "cd backend/aztec/WarpToadCore && aztec compile && aztec codegen -o src/artifacts target",
    "b:rootbridge:compile": "cd backend/aztec/L2AztecBridgeAdapter && aztec compile && aztec codegen -o src/artifacts target",
    "b:compile:aztec": "pnpm b:warptoad:compile && pnpm b:rootbridge:compile",
    "b:circuit:compile": "cd backend/circuits/withdraw && nargo compile",
    "b:circuit:vk": "node node_modules/@aztec/bb.js/dest/node/bin/index.js write_vk -b backend/circuits/withdraw/target/withdraw.json -o backend/circuits/withdraw/target -t evm",
    "b:circuit:verifier": "node node_modules/@aztec/bb.js/dest/node/bin/index.js write_solidity_verifier -k backend/circuits/withdraw/target/vk -o backend/contracts/verifier/WithdrawVerifier.sol -t evm",
    "b:circuit": "pnpm b:circuit:compile && pnpm b:circuit:vk && pnpm b:circuit:verifier",
    "b:sandbox": "aztec start --local-network",
    "bridge:dev": "pnpm --filter @warp-toad/bridge-sync dev",
    "bridge:build": "pnpm --filter @warp-toad/bridge-sync build",
    "bridge:start": "pnpm --filter @warp-toad/bridge-sync start",
    "bridge:docker": "pnpm --filter @warp-toad/bridge-sync docker:build",
    "bridge:docker:run": "pnpm --filter @warp-toad/bridge-sync docker:run",
    "bridge:docker:logs": "pnpm --filter @warp-toad/bridge-sync docker:logs",
    "bridge:docker:down": "pnpm --filter @warp-toad/bridge-sync docker:down",
    "relayer:dev": "pnpm --filter @warp-toad/relay-service dev",
    "relayer:build": "pnpm --filter @warp-toad/relay-service build",
    "relayer:start": "pnpm --filter @warp-toad/relay-service start",
    "relayer:docker": "pnpm --filter @warp-toad/relay-service docker:build",
    "relayer:docker:run": "pnpm --filter @warp-toad/relay-service docker:run",
    "relayer:docker:logs": "pnpm --filter @warp-toad/relay-service docker:logs",
    "relayer:docker:down": "pnpm --filter @warp-toad/relay-service docker:down"
  },
  "repository": "https://github.com/JossDuff/warp-toad.git",
  "author": "jossduff <jduff360@gmail.com>",
  "license": "MIT"
}
