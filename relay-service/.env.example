# WarpToad Multi-Chain Relay Service Configuration

# Relayer wallet private key (same wallet used for both L1 and Scroll)
# Make sure this wallet has ETH on both Sepolia and Scroll Sepolia
RELAYER_PRIVATE_KEY=your_private_key_here

# L1 Ethereum RPC URL (Sepolia testnet)
L1_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Scroll L2 RPC URL (Scroll Sepolia testnet)
ZKSYNC_ERA_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev

# Server configuration
PORT=7777
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://warptoad.xyz

# Fee configuration (0 = altruistic relayer, no fees)
MIN_FEE_FACTOR=0
MAX_FEE_FACTOR=0
MIN_PROFIT_USD=0

# Note: For production, set MIN_FEE_FACTOR to 25 (0.25%) or higher
# to ensure relayer profitability
