{
  "name": "@warp-toad/relay-service",
  "version": "1.0.0",
  "description": "Gasless withdrawal relay service for WarpToad",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "echo 'relay-service runs via tsx; no build step needed'",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "cd .. && docker compose build relay-service",
    "docker:run": "cd .. && docker compose up -d relay-service",
    "docker:logs": "cd .. && docker compose logs -f relay-service",
    "docker:down": "cd .. && docker compose down"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "tsx": "^4.7.0",
    "viem": "^2.41.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "author": "WarpToad",
  "license": "MIT"
}
