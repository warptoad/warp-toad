# warp-toad services - root .env
# Used by docker-compose.yml. Copy to .env and fill in.

# bridge-sync
EVM_PRIVATE_KEY=0x...
# Keeper RPCs. Comma-separated = viem fallback() across providers, most
# reliable first, so one rate limit or outage doesn't stall sync.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<KEY>
ZKSYNC_ERA_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
# Browser /rpc/:chain upstreams. Prefix any RPC var with PROXY_ to give user
# traffic its own key, so a frontend event-scan storm can't rate-limit the
# keeper. Unset = share the keeper's URL.
# PROXY_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<SECOND_KEY>
# PROXY_ZKSYNC_ERA_SEPOLIA_RPC_URL=
# Response timeout for keeper RPCs. Era's eth_estimateGas needs ~21s; viem
# defaults to 10s, which silently killed every Era local-root push.
# RPC_TIMEOUT_MS=60000
# Aztec root heartbeat: refreshes the L1-anchored aztec root when it gets
# close to the aztec testnet node's ~100-block retention window.
# AZTEC_HEARTBEAT_ENABLED=true
# AZTEC_HEARTBEAT_CHECK_INTERVAL_MS=300000
# AZTEC_HEARTBEAT_THRESHOLD_BLOCKS=80
# AZTEC_HEARTBEAT_RETENTION_BLOCKS=100

# relay-service (use a different wallet from EVM_PRIVATE_KEY)
RELAYER_PRIVATE_KEY=0x...

# faucet-service (use a third dedicated wallet, fund with ~5 ETH on each chain)
FAUCET_PRIVATE_KEY=0x...
# FAUCET_DRIP_AMOUNT_ETH=0.05

# Shared CORS
ALLOWED_ORIGINS=https://warptoad.xyz,https://www.warptoad.xyz,http://localhost:4173

# Frontend (baked at build time, requires `docker compose build frontend` to apply)
# VITE_TEST_MODE=false
# VITE_BRIDGE_KEEPER_URL=https://bridge.warptoad.xyz
# VITE_RELAY_SERVICE_URL=https://relay.warptoad.xyz
# VITE_FAUCET_SERVICE_URL=https://faucet.warptoad.xyz
