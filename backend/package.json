{
  "name": "@warp-toad/backend",
  "private": false,
  "version": "0.0.5",
  "type": "module",
  "repository": "https://github.com/warptoad/warp-toad/tree/main/backend",
  "author": "Jim Jim Valkema",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "BB_BINARY_PATH=\"${BB_BINARY_PATH:-/home/nodestarq/Projects/warptoad/aztec-packages/barretenberg/cpp/build/bin/bb}\" hardhat test",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:browser": "tsc -p tsconfig.browser.json",
    "build": "pnpm build:esm && pnpm build:cjs && pnpm build:browser",
    "cp-deployments:esm": "cp -r deploy/ignition/deployments/ dist/esm/deploy/ignition/; cp -r deploy/aztec/aztecDeployments/ dist/esm/deploy/aztec/;",
    "cp-deployments:cjs": "cp -r deploy/ignition/deployments/ dist/cjs/deploy/ignition/; cp -r deploy/aztec/aztecDeployments/ dist/cjs/deploy/aztec/;",
    "cp-deployments:browser": "cp -r deploy/ignition/deployments/ dist/browser/deploy/ignition/; cp -r deploy/aztec/aztecDeployments/ dist/browser/deploy/aztec/;",
    "cp-deployments": "pnpm cp-deployments:esm && pnpm cp-deployments:cjs && pnpm cp-deployments:browser",
    "bridge:runner": "tsx ./scripts/services/bridger.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.7",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.0",
    "@types/node": "^24.0.10",
    "hardhat": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@aztec/accounts": "4.2.0-aztecnr-rc.2",
    "@aztec/aztec.js": "4.2.0-aztecnr-rc.2",
    "@aztec/bb.js": "5.0.0-nightly.20260407",
    "@aztec/ethereum": "4.2.0-aztecnr-rc.2",
    "@aztec/foundation": "4.2.0-aztecnr-rc.2",
    "@aztec/noir-contracts.js": "4.2.0-aztecnr-rc.2",
    "@aztec/pxe": "4.2.0-aztecnr-rc.2",
    "@aztec/wallets": "4.2.0-aztecnr-rc.2",
    "@noir-lang/noir_js": "1.0.0-beta.19",
    "@openzeppelin/contracts": "^5.2.0",
    "@scroll-tech/contracts": "^2.0.1",
    "@zk-kit/imt": "^2.0.0-beta.8",
    "@zk-kit/lazy-imt.sol": "^2.0.0-beta.12",
    "@zkpassport/poseidon2": "^0.6.1",
    "argparse": "^2.0.1",
    "fixed-merkle-tree": "^0.7.3",
    "poseidon-lite": "^0.3.0",
    "viem": "^2.41.2"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "node": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "import": "./dist/browser/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./aztec/L2AztecBridgeAdapter": {
      "node": "./dist/esm/aztec/L2AztecBridgeAdapter/src/artifacts/L2AztecBridgeAdapter.js",
      "require": "./dist/cjs/aztec/L2AztecBridgeAdapter/src/artifacts/L2AztecBridgeAdapter.js",
      "import": "./dist/browser/aztec/L2AztecBridgeAdapter/src/artifacts/L2AztecBridgeAdapter.js",
      "types": "./dist/types/aztec/L2AztecBridgeAdapter/src/artifacts/L2AztecBridgeAdapter.d.ts"
    },
    "./aztec/WarpToadCore": {
      "node": "./dist/esm/aztec/WarpToadCore/src/artifacts/WarpToadCore.js",
      "require": "./dist/cjs/aztec/WarpToadCore/src/artifacts/WarpToadCore.js",
      "import": "./dist/browser/aztec/WarpToadCore/src/artifacts/WarpToadCore.js",
      "types": "./dist/types/aztec/WarpToadCore/src/artifacts/WarpToadCore.d.ts"
    },
    "./bridging": {
      "node": "./dist/esm/lib/bridging.js",
      "require": "./dist/cjs/lib/bridging.js",
      "import": "./dist/browser/lib/bridging.js",
      "types": "./dist/types/lib/bridging.d.ts"
    },
    "./constants": {
      "node": "./dist/esm/lib/constants.js",
      "require": "./dist/cjs/lib/constants.js",
      "import": "./dist/browser/lib/constants.js",
      "types": "./dist/types/lib/constants.d.ts"
    },
    "./hashing": {
      "node": "./dist/esm/lib/hashing.js",
      "require": "./dist/cjs/lib/hashing.js",
      "import": "./dist/browser/lib/hashing.js",
      "types": "./dist/types/lib/hashing.d.ts"
    },
    "./proving": {
      "node": "./dist/esm/lib/proving.js",
      "require": "./dist/cjs/lib/proving.js",
      "import": "./dist/browser/lib/proving.js",
      "types": "./dist/types/lib/proving.d.ts"
    },
    "./types": {
      "node": "./dist/esm/lib/types.js",
      "require": "./dist/cjs/lib/types.js",
      "import": "./dist/browser/lib/types.js",
      "types": "./dist/types/lib/types.d.ts"
    },
    "./deployment": {
      "node": "./dist/esm/scripts/deployment.js",
      "require": "./dist/cjs/scripts/deployment.js",
      "import": "./dist/browser/scripts/deployment.js",
      "types": "./dist/types/scripts/deployment.d.ts"
    }
  }
}
