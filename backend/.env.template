# warp-toad backend - testnet deploy env
# Copy to .env and fill in. Loaded via dotenv-cli for `pnpm t:deploy`.

DEPLOYER_PRIVATE_KEY=0x...
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/<KEY>
ZKSYNC_ERA_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com

# Etherscan v2 unified API key. One key covers Sepolia + Scroll Sepolia.
# Required for `hardhat ignition verify` (runs at the end of `pnpm t:deploy`).
# Sign up at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# Optional: only needed for `pnpm b:circuit` (rebuilding the withdraw verifier)
# BB_BINARY_PATH=/path/to/aztec-packages/barretenberg/cpp/build/bin/bb
