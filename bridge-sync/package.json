{
  "name": "@warp-toad/bridge-sync",
  "version": "1.0.0",
  "description": "HTTP service for triggering cross-chain bridge operations",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "echo 'bridge-sync runs via tsx; no build step needed'",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t bridge-sync -f Dockerfile ..",
    "docker:run": "docker compose up --build -d",
    "docker:logs": "docker compose logs -f",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@aztec/accounts": "4.2.0-aztecnr-rc.2",
    "@aztec/aztec.js": "4.2.0-aztecnr-rc.2",
    "@aztec/foundation": "4.2.0-aztecnr-rc.2",
    "@aztec/pxe": "4.2.0-aztecnr-rc.2",
    "@aztec/stdlib": "4.2.0-aztecnr-rc.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "tsx": "^4.7.0",
    "viem": "^2.41.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "author": "WarpToad",
  "license": "MIT"
}
