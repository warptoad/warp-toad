{
  "name": "@warp-toad/bridge-sync",
  "version": "1.0.0",
  "description": "HTTP service for triggering cross-chain bridge operations",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "echo 'bridge-sync runs via tsx; no build step needed'",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "cd .. && docker compose build bridge-sync",
    "docker:run": "cd .. && docker compose up -d bridge-sync",
    "docker:logs": "cd .. && docker compose logs -f bridge-sync",
    "docker:down": "cd .. && docker compose down"
  },
  "dependencies": {
    "@aztec/accounts": "5.0.0-rc.1",
    "@aztec/aztec.js": "5.0.0-rc.1",
    "@aztec/foundation": "5.0.0-rc.1",
    "@aztec/pxe": "5.0.0-rc.1",
    "@aztec/stdlib": "5.0.0-rc.1",
    "@warp-toad/backend": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "tsx": "^4.7.0",
    "viem": "^2.41.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "author": "WarpToad",
  "license": "MIT"
}
