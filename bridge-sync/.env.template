# Server Configuration
PORT=6969
NODE_ENV=production
ALLOWED_ORIGINS=https://warptoad.xyz,https://www.warptoad.xyz

# EVM Wallet (Private Key)
EVM_PRIVATE_KEY=0x...

# RPC Endpoints (keeper).
# Each accepts a comma-separated list. With more than one URL the keeper uses a
# viem fallback() transport and moves to the next provider when one errors, so a
# single rate limit or outage no longer stalls sync. Most reliable one first.
#   SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY,https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
ZKSYNC_ERA_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev
AZTEC_NODE_URL=https://v5.testnet.rpc.aztec-labs.com
LOCAL_RPC_URL=http://localhost:8545

# Browser-facing /rpc/:chain upstreams.
# Prefix any RPC var above with PROXY_ to give user traffic its own key. Without
# this the frontend shares the keeper's provider, so a withdraw that drops into
# a client-side event scan can rate-limit the keeper out of its own sync work.
# Also comma-separated. Unset = share the keeper's URL (previous behaviour).
PROXY_SEPOLIA_RPC_URL=
PROXY_ZKSYNC_ERA_SEPOLIA_RPC_URL=

# Response timeout for every keeper RPC, in ms.
# Default 60000. ZKsync Era's eth_estimateGas for sentLocalRootToL1() takes
# ~21s; viem's own 10s default silently killed every Era local-root push.
RPC_TIMEOUT_MS=60000

# Bridge Configuration
DEFAULT_CONFIRMATIONS=3
OPERATION_TIMEOUT_MS=10800000
MAX_RETRIES=3

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Database
DB_PATH=./db/bridge-keeper.db
